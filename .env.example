# Identifiant d'application (client ID) créé dans Microsoft Entra ID (Azure AD).
# Voir le README pour la procédure complète d'inscription de l'application.
VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optionnel : ID de tenant Microsoft Entra si vous voulez restreindre la connexion
# au seul tenant MA2D Construction. Laissez "common" pour accepter à la fois les
# comptes personnels et professionnels/scolaires Microsoft.
VITE_MS_TENANT_ID=common
