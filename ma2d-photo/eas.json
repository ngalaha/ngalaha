{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_DOWNLOADS_DIR": "/tmp/rn-downloads"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "REACT_NATIVE_DOWNLOADS_DIR": "/tmp/rn-downloads"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true
      },
      "env": {
        "REACT_NATIVE_DOWNLOADS_DIR": "/tmp/rn-downloads"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "À_RENSEIGNER",
        "ascAppId": "À_RENSEIGNER",
        "appleTeamId": "À_RENSEIGNER"
      },
      "android": {
        "serviceAccountKeyPath": "À_RENSEIGNER.json",
        "track": "internal"
      }
    }
  }
}
