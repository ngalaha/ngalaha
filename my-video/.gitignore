node_modules
dist
.venv
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Manim's generated media (partial movie files, cache) — keep the scene
# source and the final rendered clip out of this.
manim_diagrams/output
manim_diagrams/**/__pycache__

# Per-project generated output — regenerable from script.json/manim/*.py,
# never the source of truth. Keep public/audio, public/images,
# public/captions and a project's own README/manifests tracked. The .gitkeep
# placeholders stay so the empty template folders are still versioned.
projects/*/render/*
!projects/*/render/.gitkeep
projects/*/public/manim-render/*
!projects/*/public/manim-render/.gitkeep
projects/**/__pycache__
projects/*/manim/render_final
projects/*/manim/render_tmp*

# Regenerated by scripts/prepare-media.mjs from the tracked files in
# public/images and public/videos — never hand-edited.
projects/*/public/media-manifest.json
